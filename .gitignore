# ==============================================================================
# 1. GLOBAL & ENVIRONMENT RULES (CRITICAL SECURITY)
# ==============================================================================
# Ignore all secrets and environment files across the entire monorepo
.env
.env.*
!.env.example

# Security Keys, Certificates, and Keystores
*.pem
*.key
*.keystore
*.jks
mobile/android/key.properties

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# ==============================================================================
# 2. IDEs & WORKSPACE SETTINGS
# ==============================================================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# Eclipse / STS / NetBeans
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
/nbproject/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/




# BACKEND (SPRING BOOT / KOTLIN / MAVEN & GRADLE)
# Ignore HELP.md anywhere in backend
**/HELP.md

# Ignore local execution properties anywhere in backend
**/application-local.properties
**/application-*.properties
!**/application-dev.properties
!**/application-prod.properties

# Build & Target folders anywhere in backend
**/target/
**/build/
**/.gradle/
**/.kotlin/
**/bin/
**/*.log

# Maven Wrapper JAR
**/.mvn/wrapper/maven-wrapper.jar



# 4. MOBILE (FLUTTER / DART)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/doc/api/
**/.widget_preview/

# Symbolication & Obfuscation output
mobile/app.*.symbols
mobile/app.*.map.json

# --- Android Specific ---
mobile/android/.gradle/
mobile/android/captures/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/

# --- iOS / macOS Specific ---
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/.last_build_id
mobile/ios/DerivedData/
mobile/ios/*.xcworkspace



# 5. LOCAL INFRASTRUCTURE & PERSISTENCE
postgres_data/
redis_data/
docker_data/
*.db
*.sqlite